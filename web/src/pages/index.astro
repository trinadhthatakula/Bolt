---
import Base from "../layouts/Base.astro";
import Downloads from "../components/Downloads.astro";
import { screenshots } from "../data/screenshots.mjs";
const faqs = [
  [
    "What do I need to use Bolt?",
    "Android 7.0 or newer, working root access and an AnyKernel ZIP intended for your exact device and firmware. Bolt requires a discovered boot, init_boot or recovery target before installing. Keep an off-device backup and a recovery method you know how to use.",
  ],
  [
    "Does automatic recovery guarantee a rollback?",
    "No. Bolt snapshots the supported active-slot and shared partitions it discovers before running the installer. A kernel script can change other partitions or files. Private snapshots are lost if you clear app data or uninstall Bolt; keep additional copies outside the app.",
  ],
  [
    "Does a successful install mean the kernel will boot?",
    "Installer completion, a detected device restart and your health feedback are separate records in the Cockpit. A zero exit code alone cannot prove bootability or kernel health.",
  ],
  [
    "Can Bolt flash raw images or install KernelSU LKM?",
    "These workflows are not implemented. Bolt currently supports script-based AnyKernel ZIPs with their original installer, plus manifest-based backup and restore.",
  ],
  [
    "Where is the Play Store button?",
    "Bolt is distributed through GitHub releases. Download an APK from the latest release and install it on your device. There is no Play Store listing.",
  ],
  [
    "Which version includes the Cockpit?",
    "Bolt 1.02.0 and newer include the Cockpit shown here. The download follows GitHub’s latest stable release. Read its release notes to see which features are included.",
  ],
];
const schema = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: "Bolt",
  operatingSystem: "Android 7.0+",
  applicationCategory: "UtilitiesApplication",
  url: "https://bolt.trinadhthatakula.com",
  downloadUrl: "https://github.com/trinadhthatakula/Bolt/releases/latest",
  license: "https://www.gnu.org/licenses/gpl-3.0.html",
  description:
    "Open-source AnyKernel ZIP flasher for rooted Android with a Cockpit, recovery bundles and readable installer logs.",
  screenshot: screenshots.map(
    (s) => "https://bolt.trinadhthatakula.com/screenshots/" + s.name + ".webp",
  ),
};
---

<Base>
  <main id="main" class="wrap">
    <section class="hero" aria-labelledby="hero-title">
      <div class="hero-copy">
        <span class="eyebrow">
          <span class="status-dot"></span> ANYKERNEL. ANDROID. OPEN SOURCE.
        </span>
        <h1 id="hero-title">
          Your next kernel.
          <br />
          <span>A clearer cockpit.</span>
        </h1>
        <p class="hero-description">
          Meet Bolt. A focused kernel flasher with room for your originals, your
          next step, and every line from your installer.
        </p>
        <div class="hero-actions">
          <a href="#download" class="button primary">
            Download from GitHub <span aria-hidden="true">↓</span>
          </a>
          <a href="#tour" class="text-link">
            Take a look <span aria-hidden="true">↘</span>
          </a>
        </div>
        <p class="hero-note">Cockpit · Root required · Android 7.0+</p>
      </div>
      <figure class="hero-device">
        <div class="phone-frame">
          <img
            src="/screenshots/01-overview.webp"
            width="1080"
            height="1920"
            alt={screenshots[0].alt}
            fetchpriority="high"
          />
        </div>
        <figcaption>
          <span class="status-dot"></span> CURRENT UI · EMULATOR + SAMPLE BUNDLE
        </figcaption>
      </figure>
    </section>
    <div class="principles">
      <span>Original installer.</span>
      <span>Original images.</span>
      <span>A clear next step.</span>
      <a href="https://github.com/trinadhthatakula/Bolt">
        Always open source <span aria-hidden="true">↗</span>
      </a>
    </div>

    <section class="intro-section" id="features">
      <div class="section-heading">
        <span class="eyebrow">MEET THE COCKPIT</span>
        <h2>
          Less hunting.
          <br />
          <span>More understanding.</span>
        </h2>
      </div>
      <p class="section-description">
        Kernel work deserves a clear interface. Bolt brings installation,
        recovery and activity together, with the details there when you need
        them.
      </p>
      <div class="feature-grid">
        <article class="feature feature-main">
          <span class="feature-number">01 / INSTALL</span>
          <h3>
            Pick a ZIP.
            <br />
            Know the next step.
          </h3>
          <p>
            Import a compatible AnyKernel package, review the device and
            recovery plan, then run its original installer. Receiving a ZIP
            never starts flashing.
          </p>
          <div class="flow" aria-label="Install flow">
            <span>Choose ZIP</span>
            <span aria-hidden="true">→</span>
            <span>Review</span>
            <span aria-hidden="true">→</span>
            <span>Install</span>
          </div>
          <a href="https://github.com/trinadhthatakula/Bolt/blob/master/docs/kernel-flashing.md">
            Read the operation guide <span aria-hidden="true">↗</span>
          </a>
        </article>
        <article class="feature">
          <span class="feature-number">02 / RECOVERY</span>
          <h3>
            Keep your
            <br />
            originals together.
          </h3>
          <p>
            Automatic snapshots become compact recovery bundles. Open one to
            inspect its images, then review a manifest-checked restore.
          </p>
          <div class="partition-tags" aria-label="Example partition names">
            <span>boot_a</span>
            <span>init_boot_a</span>
            <span>vendor_boot_a</span>
            <span>dtbo_a</span>
            <span>vbmeta_a</span>
            <span>recovery_a</span>
          </div>
          <p class="small">
            Example inventory. Available targets depend on your device.
          </p>
        </article>
        <article class="feature">
          <span class="feature-number">03 / ACTIVITY</span>
          <h3>
            See what
            <br />
            your installer says.
          </h3>
          <p>
            Readable logs show the kernel provider’s messages and artwork. Keep
            the raw view and export the original log for troubleshooting.
          </p>
          <div class="log-example">
            <span>Readable log</span>
            <pre>Checking compatibility…
Preparing original images…
Your provider’s messages, here.</pre>
            <span class="small">Illustrative provider output</span>
          </div>
        </article>
      </div>
    </section>

    <section id="tour" class="tour-section" aria-labelledby="tour-title">
      <div class="section-heading">
        <span class="eyebrow">THE SCREEN TOUR</span>
        <h2 id="tour-title">A closer look.</h2>
        <p>
          Real screens from the current Android app. Select an image to see it
          full size.
        </p>
      </div>
      <p class="preview-notice">
        Captured on a rooted emulator with a sample recovery bundle and sample
        log. No kernel was flashed for these screenshots.
      </p>
      <div class="screenshot-gallery">
        {screenshots.map((s, i) => (
          <figure>
            <a
              href={"/screenshots/" + s.name + ".webp"}
              class="screenshot-link"
              aria-label={"Enlarge screenshot: " + s.title}
            >
              <img
                src={"/screenshots/" + s.name + ".webp"}
                width="1080"
                height="1920"
                loading="lazy"
                decoding="async"
                alt={s.alt}
              />
            </a>
            <figcaption>
              <span class="eyebrow">{"0" + (i + 1)}</span>
              <h3>{s.title}</h3>
              <p>{s.caption}</p>
            </figcaption>
          </figure>
        ))}
      </div>
      <dialog id="screenshot-dialog" aria-label="Full size app screenshot">
        <button
          type="button"
          class="dialog-close"
          aria-label="Close screenshot"
        >
          Close ×
        </button>
        <img id="full-screenshot" alt="" />
        <p id="full-caption"></p>
      </dialog>
    </section>

    <section class="appearance-section">
      <div>
        <span class="eyebrow">ASGARDIAN BY DESIGN</span>
        <h2>
          Familiar colors.
          <br />
          <span>Your kind of type.</span>
        </h2>
        <p>
          Outfit for the words. Fira Code for the details. The same Asgardian
          family as Thor, with light, dark, AMOLED and system-font settings
          inside Bolt.
        </p>
        <a
          class="text-link"
          href="https://github.com/trinadhthatakula/Bolt/blob/master/docs/appearance.md"
        >
          Explore appearance settings <span aria-hidden="true">↗</span>
        </a>
      </div>
      <div class="type-sample" aria-label="Typography sample">
        <span class="sample-display">Aa.</span>
        <span class="eyebrow">OUTFIT / 100—900</span>
        <div class="sample-mono">
          boot_a
          <br />
          SHA-256
          <br />
          <span>FIRA CODE / 400, 500</span>
        </div>
      </div>
    </section>

    <section class="requirements">
      <span class="eyebrow">BEFORE YOU BEGIN</span>
      <h2>
        Know your device.
        <br />
        Keep a way back.
      </h2>
      <p>
        Kernel flashing can cause a bootloop or data loss. Use a trusted package
        built for your device and keep off-device backups and a working recovery
        route. Automatic snapshots cover discovered targets; they cannot cover
        every change a root installer may make.
      </p>
      <a
        class="text-link"
        href="https://github.com/trinadhthatakula/Bolt/blob/master/docs/testing.md"
      >
        Device validation and current limits <span aria-hidden="true">↗</span>
      </a>
    </section>
    <Downloads />
    <section class="faq-section" aria-labelledby="faq-title">
      <div class="section-heading">
        <span class="eyebrow">A FEW THINGS TO KNOW</span>
        <h2 id="faq-title">Questions, answered.</h2>
      </div>
      <div class="faq-list">
        {faqs.map(([question, answer]) => (
          <details>
            <summary>
              {question}
              <span aria-hidden="true">+</span>
            </summary>
            <p>{answer}</p>
          </details>
        ))}
      </div>
    </section>
  </main>
  <script
    type="application/ld+json"
    set:html={JSON.stringify(schema).replace(/</g, "\\u003c")}
  />
</Base>
<script>
  const dialog = document.getElementById(
    "screenshot-dialog",
  ) as HTMLDialogElement;
  const full = document.getElementById("full-screenshot") as HTMLImageElement;
  const caption = document.getElementById("full-caption");
  let opener: HTMLElement | null = null;
  if (dialog && typeof dialog.showModal === "function") {
    document
      .querySelectorAll<HTMLAnchorElement>(".screenshot-link")
      .forEach((link) =>
        link.addEventListener("click", (event) => {
          if (event.ctrlKey || event.metaKey || event.shiftKey || event.altKey)
            return;
          event.preventDefault();
          const image = link.querySelector("img");
          if (!image) return;
          opener = link;
          full.src = link.href;
          full.alt = image.alt;
          if (caption) caption.textContent = image.alt;
          dialog.showModal();
        }),
      );
    dialog
      .querySelector("button")
      ?.addEventListener("click", () => dialog.close());
    dialog.addEventListener("click", (event) => {
      if (event.target === dialog) {
        const r = dialog.getBoundingClientRect();
        if (
          event.clientX < r.left ||
          event.clientX > r.right ||
          event.clientY < r.top ||
          event.clientY > r.bottom
        )
          dialog.close();
      }
    });
    dialog.addEventListener("close", () => opener?.focus());
  }
</script>
