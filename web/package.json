{
  "name": "bolt-web",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev --host 127.0.0.1",
    "build": "astro build && node scripts/validate.mjs",
    "preview": "astro preview --host 127.0.0.1",
    "test": "node --test src/lib/releases.test.mjs",
    "assets": "node scripts/render-assets.mjs",
    "check:metadata": "node scripts/check-metadata.mjs",
    "format": "prettier --plugin=prettier-plugin-astro --write src scripts",
    "format:check": "prettier --plugin=prettier-plugin-astro --check src scripts"
  },
  "dependencies": {
    "astro": "7.3.8"
  },
  "devDependencies": {
    "cheerio": "1.2.0",
    "fontkit": "2.0.4",
    "prettier": "3.9.10",
    "prettier-plugin-astro": "1.1.1",
    "sharp": "0.35.5"
  }
}
