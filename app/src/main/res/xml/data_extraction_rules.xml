<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="recovery/" />
        <exclude domain="file" path="logs/" />
        <exclude domain="file" path="operation.json" />
        <exclude domain="file" path="operation.json.bak" />
        <exclude domain="file" path="operation.json.new" />
        <exclude domain="file" path="flash-journeys.json" />
        <exclude domain="file" path="flash-journeys.json.bak" />
        <exclude domain="file" path="flash-journeys.json.new" />
        <exclude domain="file" path="flash-history.json" />
        <exclude domain="file" path="flash-history.json.bak" />
        <exclude domain="file" path="flash-history.json.new" />
        <exclude domain="file" path="flash_history.txt" />
